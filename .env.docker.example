# Replace every placeholder before running docker compose.
# Use the same ADO.NET-style SQL_SERVER_CONNSTRING that db/setup_temp_tables.py uses.
SQL_SERVER_CONNSTRING=Server=tcp:<your-azure-sql-server>.database.windows.net,1433;User Id=<your-user>;Password=<your-password>;
MSSQL_DATABASE=dev-golfcarts
MSSQL_TABLE_PREFIX=temp_Brian_

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5

# Copy to .env and fill in real values. .env is gitignored (never commit secrets).
# Used by `npm run dev` (mssql mode) and the Python server (server/eval_runner.py).
# The ADO.NET-style connstring; same format db/setup_temp_tables.py uses.
SQL_SERVER_CONNSTRING=Server=<your-azure-sql-server>.database.windows.net;Database=dev-golfcarts;User Id=<your-user>;Password=<your-password>;TrustServerCertificate=True;

# Azure OpenAI (also accepted from .env.local / .env.docker). Required for
# running evals and post-edits; the app starts without them but those calls fail.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5
